index 0000000..1d18938
--- /dev/null
+++ b/packages/core/src/layout/cjk-tracking-balance.ts
@@ -0,0 +1,61 @@
+import type { FieldAwarePiece } from './field-pieces.ts';
+import { segmentGraphemes } from './grapheme.ts';
+
+// With balanceSingleByteDoubleByteWidth, native Word applies twice the authored
+// tracking to fullwidth East Asian characters, retaining ordinary Latin tracking.
+// This is a layout projection: the source run properties and model offsets stay intact.
+const fullwidth =
+  /^[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}\u3000-\u303f\uff01-\uff60\uffe0-\uffe6]/u;
+
+export function balanceCjkTrackingPieces(pieces: FieldAwarePiece[]): FieldAwarePiece[] {
+  return pieces.flatMap((piece) => {
+    if (
+      !piece.style.characterSpacingPt ||
+      piece.projected ||
+      piece.measureText !== undefined ||
+      piece.breakKind ||
+      piece.positionalTab ||
+      piece.inlineDrawing ||
+      piece.anchoredAtom ||
+      piece.equation ||
+      piece.style.latinLane ||
+      piece.end - piece.start !== piece.text.length
+    )
+      return [piece];
+    const segments = segmentGraphemes(piece.text);
+    const out: FieldAwarePiece[] = [];
+    let from = 0,
+      factor = 1;
+    const emit = (to: number) => {
+      if (to <= from) return;
+      out.push({
+        ...piece,
+        text: piece.text.slice(from, to),
+        start: piece.start + from,
+        end: piece.start + to,
+        style:
+          factor === 1
+            ? piece.style
+            : {
+                ...piece.style,
+                characterSpacingPt: piece.style.characterSpacingPt * factor,
+              },
+      });
+      from = to;
+    };
+    for (const segment of segments) {
+      const code = segment.text.codePointAt(0)!;
+      // Halfwidth kana and Hangul retain their halfwidth tracking.
+      const next =
+        fullwidth.test(segment.text) && !(code >= 0xff61 && code <= 0xffdc)
+          ? 2 / segment.text.length
+          : 1;
+      if (next !== factor) {
+        emit(segment.utf16From);
+        factor = next;
+      }
+    }
+    emit(piece.text.length);
+    return out.length === 1 && out[0]!.style === piece.style ? [piece] : out;
+  });
+}
