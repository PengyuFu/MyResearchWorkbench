diff --git a/packages/core/src/layout/__tests__/cjk-space-balance.test.ts b/packages/core/src/layout/__tests__/cjk-space-balance.test.ts
new file mode 100644
index 0000000..ca99b26
--- /dev/null
+++ b/packages/core/src/layout/__tests__/cjk-space-balance.test.ts
@@ -0,0 +1,142 @@
+import { expect, test } from 'bun:test';
+import { readOoxmlPart, serializeOoxmlPart } from '../../store/package/ooxml-tree.ts';
+import { layoutSemanticDocument } from '../semantic-layout.ts';
+import { buildStyleCascadeTable } from '../style-cascade.ts';
+
+const W = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main';
+const read = (xml: string, name: string) => {
+  const result = readOoxmlPart(xml, { name, contentType: 'app/xml' });
+  if (!result.ok) throw new Error(result.reason);
+  return result.part;
+};
+const styles = read(
+  '<w:styles xmlns:w="' +
+    W +
+    '"><w:docDefaults><w:rPrDefault><w:rPr>' +
+    '<w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:eastAsia="宋体"/>' +
+    '<w:sz w:val="24"/></w:rPr></w:rPrDefault></w:docDefaults></w:styles>',
+  '/word/styles.xml'
+);
+function measure(
+  parts: string[],
+  balance: 'on' | 'off' | 'missing' = 'on',
+  table = false,
+  width = 300
+) {
+  const settings = read(
+    '<w:settings xmlns:w="' +
+      W +
+      '"><w:compat>' +
+      (balance === 'missing'
+        ? ''
+        : '<w:balanceSingleByteDoubleByteWidth w:val="' + (balance === 'on' ? '1' : '0') + '"/>') +
+      '</w:compat></w:settings>',
+    '/word/settings.xml'
+  );
+  const p =
+    '<w:p><w:pPr><w:jc w:val="left"/></w:pPr>' +
+    parts.map((text) => '<w:r><w:t xml:space="preserve">' + text + '</w:t></w:r>').join('') +
+    '</w:p>';
+  const body = table
+    ? '<w:tbl><w:tblPr><w:tblLayout w:type="autofit"/></w:tblPr><w:tblGrid><w:gridCol w:w="4000"/></w:tblGrid><w:tr><w:tc>' +
+      p +
+      '</w:tc></w:tr></w:tbl>'
+    : p;
+  const part = read(
+    '<w:document xmlns:w="' + W + '"><w:body>' + body + '</w:body></w:document>',
+    '/word/document.xml'
+  );
+  const before = serializeOoxmlPart(part);
+  const styleCascade = buildStyleCascadeTable(styles.root, undefined, settings.root);
+  const layout = layoutSemanticDocument(part, 0, {
+    compatibilityMode: 15,
+    styleCascade,
+    geometry: { width, height: 400, margin: { top: 0, bottom: 0, left: 0, right: 0 } },
+    measurer: {
+      measure: (text, style) =>
+        [...text].reduce(
+          (sum, ch) =>
+            sum +
+            (ch === ' ' ? (style.fontFamily === '宋体' ? 6 : 3) : /[A-Za-z]/.test(ch) ? 6 : 12),
+          0
+        ),
+      lineMetrics: () => ({ height: 12, baseline: 10 }),
+    },
+  });
+  const first = layout.pages[0]!.fragments[0]!;
+  const paragraph = first.kind === 'paragraph' ? first : first.rows[0]!.cells[0]!.blocks[0]!;
+  if (paragraph.kind !== 'paragraph') throw new Error('Expected paragraph');
+  expect(serializeOoxmlPart(part)).toBe(before);
+  expect(paragraph.lines).toHaveLength(1);
+  return paragraph.lines
+    .flatMap((line) => line.spans)
+    .filter((span) => /^ +$/.test(span.text))
+    .map((span) => span.box.width / span.text.length);
+}
+
+test('a Chinese title balances spaces without changing its XML', () => {
+  expect(measure(['开 题 报 告'])).toEqual([6, 6, 6]);
+});
+test('Latin word spaces keep their natural width in a mixed paragraph', () => {
+  expect(measure(['中 A B 文'])).toEqual([6, 3, 6]);
+});
+test('space groups cross source-run boundaries', () => {
+  expect(measure(['A', ' ', ' ', '中', '文'])).toEqual([6, 6]);
+});
+test('an absent or disabled option keeps Latin-space advances', () => {
+  expect(measure(['开 题 报 告'], 'off')).toEqual([3, 3, 3]);
+  expect(measure(['开 题 报 告'], 'missing')).toEqual([3, 3, 3]);
+});
+test('autofit table content uses the same balanced advances', () => {
+  expect(measure(['中 A B 文'], 'on', true)).toEqual([6, 3, 6]);
+});
+
+test('a balanced CJK label fits a narrow cell-sized line', () => {
+  expect(measure(['专 业'], 'on', false, 35.55)).toEqual([6]);
+});
+
+test('Word balanced tracking doubles fullwidth advances while preserving the saved run', () => {
+  for (const spacing of [20, -10])
+    for (const enabled of [true, false]) {
+      const part = read(
+        '<w:document xmlns:w="' +
+          W +
+          '"><w:body><w:p><w:pPr>' +
+          '<w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/></w:pPr><w:r><w:rPr>' +
+          '<w:rFonts w:ascii="宋体" w:hAnsi="宋体" w:eastAsia="宋体"/><w:sz w:val="21"/>' +
+          '<w:spacing w:val="' +
+          spacing +
+          '"/></w:rPr><w:t>X甲．乙Y</w:t></w:r>' +
+          '</w:p></w:body></w:document>',
+        '/word/document.xml'
+      );
+      const before = serializeOoxmlPart(part);
+      const settings = read(
+        '<w:settings xmlns:w="' +
+          W +
+          '"><w:compat>' +
+          '<w:balanceSingleByteDoubleByteWidth w:val="' +
+          (enabled ? '1' : '0') +
+          '"/>' +
+          '</w:compat></w:settings>',
+        '/word/settings.xml'
+      );
+      const layout = layoutSemanticDocument(part, 0, {
+        styleCascade: buildStyleCascadeTable(styles.root, undefined, settings.root),
+        measurer: {
+          measure: (text, style) =>
+            [...text].reduce((sum, ch) => sum + (/[XY]/.test(ch) ? 5.25 : 10.5), 0) +
+            text.length * style.characterSpacingPt,
+          lineMetrics: () => ({ height: 13.65, baseline: 10.5 }),
+        },
+      });
+      const paragraph = layout.pages[0]!.fragments[0]!;
+      if (paragraph.kind !== 'paragraph') throw new Error('Expected paragraph');
+      const spans = paragraph.lines[0]!.spans;
+      expect(spans.map((span) => span.text).join('')).toBe('X甲．乙Y');
+      expect(spans.reduce((sum, span) => sum + span.box.width, 0)).toBeCloseTo(
+        42 + ((enabled ? 8 : 5) * spacing) / 20
+      );
+      expect(serializeOoxmlPart(part)).toBe(before);
+    }
+});
