+import type { FieldAwarePiece } from './field-pieces.ts';
+import { balanceCjkTrackingPieces } from './cjk-tracking-balance.ts';
+
+// Word's balanceSingleByteDoubleByteWidth option uses the East Asian face for
+// ordinary spaces touching East Asian text. Spaces between Latin words keep
+// their Latin face. Resolve whole space groups across source-run boundaries.
+const EA =
+  '[\\p{Script=Han}\\p{Script=Hiragana}\\p{Script=Katakana}\\p{Script=Hangul}\\u3000-\\u303f\\uff01-\\uffef]';
+const endsEastAsian = new RegExp(EA + '$', 'u');
+const startsEastAsian = new RegExp('^' + EA, 'u');
+
+export function balanceCjkSpacePieces(
+  pieces: FieldAwarePiece[],
+  enabled: boolean | undefined
+): FieldAwarePiece[] {
+  if (!enabled) return pieces;
+  pieces = balanceCjkTrackingPieces(pieces);
+  const context = pieces.map((piece) =>
+    piece.breakKind || piece.inlineDrawing || piece.anchoredAtom || piece.equation
+      ? '\u0000'.repeat(Math.max(1, piece.text.length))
+      : piece.text
+  );
+  const text = context.join('');
+  const spaces: { from: number; to: number }[] = [];
+  for (const match of text.matchAll(/ +/g)) {
+    const from = match.index;
+    const to = from + match[0].length;
+    if (
+      endsEastAsian.test(text.slice(Math.max(0, from - 2), from)) ||
+      startsEastAsian.test(text.slice(to, to + 2))
+    )
+      spaces.push({ from, to });
+  }
+  if (!spaces.length) return pieces;
+
+  const out: FieldAwarePiece[] = [];
+  let position = 0;
+  let spaceIndex = 0;
+  for (let index = 0; index < pieces.length; index++) {
+    const piece = pieces[index]!;
+    const start = position;
+    position += context[index]!.length;
+    while (spaceIndex < spaces.length && spaces[spaceIndex]!.to <= start) spaceIndex++;
+    const literal = !piece.projected && piece.end - piece.start === piece.text.length;
+    const projectedField = piece.projected === true && piece.fieldAtom != null;
+    if (
+      (!literal && !projectedField) ||
+      piece.style.fontFamilyEastAsia === null ||
+      piece.measureText !== undefined ||
+      !piece.text.includes(' ')
+    ) {
+      out.push(piece);
+      continue;
+    }
+    const slice = (from: number, to: number, balance: boolean): FieldAwarePiece => ({
+      ...piece,
+      text: piece.text.slice(from, to),
+      ...(literal ? { start: piece.start + from, end: piece.start + to } : {}),
+      ...(balance ? { fontSlot: 'eastAsia' as const } : {}),
+    });
+    let cursor = 0;
+    for (let at = spaceIndex; at < spaces.length && spaces[at]!.from < position; at++) {
+      const range = spaces[at]!;
+      const from = Math.max(0, range.from - start);
+      const to = Math.min(piece.text.length, range.to - start);
